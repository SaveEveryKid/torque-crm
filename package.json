{
  "name": "torque-crm",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Torque CRM: a personal CRM for selling, hosted on your own Cloudflare account.",
  "scripts": {
    "dev": "vite",
    "dev:cloud": "vite build && wrangler pages dev dist --d1 DB=local-db",
    "build": "tsc --noEmit && tsc --noEmit -p functions && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "typescript": "~5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.155.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
