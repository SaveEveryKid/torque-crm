// Torque CRM on Cloudflare Workers. Cloudflare builds and deploys this on every push.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "torque-crm",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Lets this Worker call your dialer Worker at its workers.dev address (same account).
  // Without it Cloudflare blocks Worker-to-Worker calls on workers.dev (error 1042).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // The app (vite build → dist). /api/* and /dealer/* go to the Worker first.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/dealer/*", "/sms/*"]
  },
  // Your customers and history. Found by name: the D1 database called "torque-crm" on your account.
  "d1_databases": [{ "binding": "DB", "database_name": "torque-crm" }]
  // Secrets (Settings → Variables and Secrets): APP_PASSWORD, DIALER_URL, DIALER_PASSWORD,
  // and for texting: SW_SPACE, SW_PROJECT_ID, SW_API_TOKEN, SMS_FROM.
}
